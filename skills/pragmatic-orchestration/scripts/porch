#!/bin/bash
#
# porch — single public CLI for pragmatic-orchestration v5
#
# Modes:
#   porch review ask  [...]
#   porch review code -a <exact-agent-id> [...]
#   porch delegate -a <exact-agent-id> [...]
#   porch delegate wait|watch|events|list [...]
#   porch media transcribe|image|capabilities [...]
#   porch quota [all|codex|grok]
#   porch sessions roots|list|grep|show [...]
#   porch desktop list|search|read|projects|start|open|archive|unarchive [...]
#   porch prune [--apply] [--older-than AGE] [...]
#
# Observability contract:
#   compact semantic live progress → stderr
#   clean final answer → stdout
#   per-run artifacts under PORCH_RUN_DIR / PORCH_OUTPUT_DIR
#
set -euo pipefail

# `pwd -W`: C:/... form on Git Bash for native Python (see lib/common.sh).
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && { pwd -W 2>/dev/null || pwd; })"
LIB_DIR="$SCRIPT_DIR/lib"

# shellcheck source=lib/common.sh
source "$LIB_DIR/common.sh"
# shellcheck source=lib/progress.sh
source "$LIB_DIR/progress.sh"

usage() {
    cat <<'EOF'
porch — independent review and single-agent YOLO delegation

Usage:
  porch review ask [options] ["question"]
  porch review ask -a <agent-id> --researcher <agent-id> [--researcher ...] [--assignment] ["task"]
  porch review code -a <agent-id> [options] <file|--diff>
  porch delegate -a <exact-agent-id> ["task"]
  porch delegate -a <exact-agent-id> --one-shot ["task"]
  porch delegate -a <exact-agent-id> --detach ["task"]
  porch delegate -a <codex-profile> --persist-session [--detach] "task"
  porch delegate -a <codex-profile> --continue-run RUN_ID [--detach] "follow-up"
  porch delegate -a <codex-profile> --continue-run RUN_ID --recover-session [--detach] "remaining work"
  porch delegate steer RUN_ID [--mode auto|queue|interrupt] [--prompt-file FILE] "guidance"
  porch delegate status RUN_ID [--json]
  porch delegate cancel RUN_ID
  porch delegate wait RUN_ID [--timeout SEC] [--json] [--quiet]
  porch delegate wait-any RUN_ID [RUN_ID ...] [--timeout SEC]
  porch delegate watch RUN_ID [--heartbeat SEC] [--json]
  porch delegate events RUN_ID [--cursor N] [--max-events N]
  porch delegate list [--active|--all] [--reap] [--json]
  porch media transcribe -a <agent-id> [--format text|srt|vtt|json] [--out FILE] FILE
  porch media image describe -a <agent-id> --input IMAGE [--input IMAGE ...] ["question"]
  porch media image generate -a <agent-id> [--count N] [--aspect 16:9] [--out-dir DIR] "prompt"
  porch media image edit -a <agent-id> --input IMAGE [...] [--count N] [--out-dir DIR] "instruction"
  porch media image animate -a <agent-id> [--frames N] [--frame-ms MS] [--out-dir DIR] "motion"
  porch media capabilities [--json]
  porch quota [all|codex|grok]
  porch fleet probe|status|plan|launch|control|reconcile [options]
  porch ui [--desktop] [--port PORT] [--registry-root PATH]
  porch sessions roots [-a harness[,harness...]] [--store SUBSTR]
  porch sessions list [-a ...] [--store S] [--cwd S] [--since T] [--until T] [--limit N]
  porch sessions find GROUP [GROUP ...] [-a ...] [--kind title|prompt|answer]
  porch sessions trace REF [REF ...] [--depth N] [--max-nodes N] [--evidence]
  porch sessions trace --left-behind [--since T] [--cwd DIR] [-a HARNESS] [--evidence]
  porch sessions index status|build|drop
  porch sessions grep [-a ...] [--scope SCOPE] [-i] [--regex] [--limit N] PATTERN
  porch sessions show <harness:session-id|--file PATH> [--around SEQ] [--context N]
                          [--scope SCOPE] [--max-chars N]
  porch sessions turns [-a ...] [--since T] [--until T] [--limit N]
  porch sessions flags [-a ...] [--kind PATTERN] [--since T] [--limit N]
  porch sessions stats [-a ...] [--by model|harness|cwd|day] [--since T]
  porch desktop list|search|read [--app claude|codex|all] [--project S] [--state active|archived|any] [...]
  porch desktop projects|start|open|archive|unarchive [...]   (Claude Desktop / Codex app; macOS)
  porch prune [--apply] [--older-than AGE] [--detail-older-than AGE] [--max-detail-size SIZE]
              [--all] [--json]
  porch --list-agents
  porch -h | --help

review ask
  Ask exactly one explicitly selected profile for an independent review.
  Options: --xml, --list-agents, --prompt-file, --context-stdin, -a/--agent,
           --progress full|compact|none, --researcher ID, --assignment
  --researcher ID (repeatable)
      The worker stays read-only but may start read-only researchers on the
      named profiles, and nothing else: its own subagent limited to a
      researcher on the model of a named profile of the same backend, and,
      where its shell is not sandboxed, a nested `porch review ask -a ID`.
      Supported: Codex CLI, Claude Code, OpenCode, Grok Build, Antigravity
      CLI. Any other backend, or a profile list the backend cannot reach, is
      refused with exit 4; nothing is downgraded silently. Without the flag
      the worker works alone.
  --assignment
      Treat the prompt as a read-only assignment: no adviser role, no profile
      role text and no five fixed headings. The worker answers in the
      structure its brief asks for. The read-only contract still applies.

review code
  One independent code review. Options: -a ID, --xml, --diff,
  --related FILE (repeatable), --progress full|compact|none.

Live progress (review)
  full (default)  per-agent thinking / answer previews on stderr, keyed by the
                  invocation (agent, agent.role, stage.index.agent.role) so
                  parallel passes of the same agent stay distinguishable
  compact         content-free liveness counters (chunks/chars/elapsed)
  none            silence — stdout still carries the report
  Env fallback: PORCH_PROGRESS.

delegate
  Full-YOLO: run exactly one agent in the current directory with no sandbox
  and no approval prompts. Requires -a <exact-agent-id> (no globs, no default).
  Supported backends: codex-cli, claude-code, opencode, grok-build, devin-cli,
  antigravity-cli.
  Gemini is review-only.
  Starts a long-lived session with mailbox steer/status/cancel by default.
  --steerable is an explicit alias for the default; --one-shot uses the legacy
  direct run. --detach prints run_id and returns immediately; the
  supervisor becomes its own session leader and outlives the caller.
  wait blocks until the run is terminal and prints the full final answer.
    Exit: 0 completed, 130 cancelled, 70 supervisor died, 74 completed without
    an answer.
  watch emits lifecycle changes and heartbeats, not tool/file/text progress,
  and exits with the same codes. Use wait to print the final answer.
  events returns one bounded JSON page of normalized progress and exits. Reuse
  next_cursor as --cursor on the next observation.
  list finds runs again after the run id was lost.

media
  Read-only media work through one exact profile; `media capabilities` lists
  which profiles support each operation (transcribe: Antigravity; image
  describe: Antigravity, Codex, Claude Code; image generate/edit/animate:
  Antigravity, Codex). transcribe and animate need ffmpeg. transcribe converts
  audio or video to MP3/WAV, splits long recordings (--segment-minutes,
  default 15) and prints the transcript (text, srt, vtt or json) on stdout or
  to --out. Image generate and edit collect the images the harness's own tool
  saved for that session, copy them to --out-dir and print a JSON manifest on
  stdout; animate turns one generated spritesheet into a looping GIF.
    Exit: 0 done, 2 fewer images than --count, 4 unsupported profile or
    missing ffmpeg, 5 usage, 66 nothing transcribed or generated.

quota
  Return machine-readable remaining subscription quota for Codex, Grok, or
  both. Codex uses its typed app-server API. Grok uses the official /usage TUI
  command on the SSH host (default: grok-aws). A partial result exits 2; all
  requested providers failing exits 3.

sessions
  Read-only search and navigation over local coding-agent session histories
  (claude-code, codex, opencode, grok, devin, gemini, cursor, qwen-code,
  kimi-code, omp, claude-desktop, plus porch's own runs). Raw commands stream
  decoded records with native locators; find uses a private disposable index.
    roots  detected stores, availability, evidence level
    list   session ids with title, cwd, dates, models
    find   fast literal search of titles, prompts and completed answers
    trace  session lineage and indexed evidence
    index  status, build [--full], or drop the find index
    grep   text search; each hit carries kind (prompt/assistant/reasoning/
           tool_call/tool_result/context/permission/metadata/…), authorship,
           model, ts, seq, rel ids
    show   one session's fragments; --around SEQ emits a ±--context window
    turns  one row per user-triggered turn: duration, models, tool/error/
           retry counts, usage, has_final, first/last locators
    flags  deterministic anti-patterns (retry_loop, search_loop,
           edit_without_read, correction(_burst), abandoned,
           permission_friction, context_pressure, interrupted, error_burst,
           failed_run) — each carries evidence locators, not verdicts
    stats  grouped aggregates (--by model|harness|cwd|day): sessions, turns,
           error rate, compactions, median turn duration, token usage, flags
  Scope presets: convo (default) = prompts+assistant; prompts, assistant,
  tools, reasoning, system, all. Classification rules and per-harness format
  recipes: references/session-history.md.

prune
  Retention for saved run outputs (PORCH_OUTPUT_DIR) and the steerable run
  registry (PORCH_STEER_DIR). Without --apply it only lists what would go.
  Finished runs older than --older-than (default 30d) are removed; the bulky
  raw/ and normalized/ streams of finished runs go after --detail-older-than
  (default 3d), or sooner, oldest first, while they exceed --max-detail-size
  (default 2G; never within a run's first day). Final answers and metadata
  stay for the full period. A running run is never touched. porch also runs
  `prune --apply` by itself at most every six hours; PORCH_RETENTION_AUTO=0
  turns that off.
    Exit: 0 done or nothing to do, 1 a removal failed, 5 usage.

Environment:
  PORCH_CONFIG, PORCH_PROGRESS, PORCH_OUTPUT_DIR, PORCH_RUN_DIR, PORCH_SAVE_OUTPUTS,
  PORCH_STEER_DIR, PORCH_RETENTION_DAYS, PORCH_RETENTION_DETAIL_DAYS,
  PORCH_RETENTION_DETAIL_MAX, PORCH_RETENTION_AUTO, PORCH_STREAM_FULL (1 saves
  the complete event streams of a run, for debugging) and per-backend
  model/effort overrides — see SKILL.md.
EOF
}

if [[ $# -eq 0 ]]; then
    usage
    exit $EXIT_USAGE
fi

# Inside a read-only review worker's shell only `review ask` is available.
porch_nested_guard "$1" "${2:-}" || exit $EXIT_CONFIG_ERROR

case "$1" in
    -h|--help|help)
        usage
        exit $EXIT_OK
        ;;
    --list-agents)
        # shellcheck source=lib/config.sh
        source "$LIB_DIR/config.sh"
        config_validate || exit $EXIT_CONFIG_ERROR
        config_xml_plan
        exit $EXIT_OK
        ;;
    review)
        shift
        sub="${1:-}"
        [[ -n "$sub" ]] || { echo "Error: review requires 'ask' or 'code'" >&2; exit $EXIT_USAGE; }
        shift
        case "$sub" in
            ask)
                exec bash "$LIB_DIR/review_ask.sh" "$@"
                ;;
            code)
                exec bash "$LIB_DIR/review_code.sh" "$@"
                ;;
            *)
                echo "Error: unknown review subcommand: $sub (expected ask|code)" >&2
                exit $EXIT_USAGE
                ;;
        esac
        ;;
    delegate)
        shift
        exec bash "$LIB_DIR/delegate.sh" "$@"
        ;;
    ui)
        shift
        PY=$(command -v python3 || command -v python) || exit "$EXIT_USAGE"
        export PYTHONPATH="${LIB_DIR}${PYTHONPATH:+:$PYTHONPATH}"
        exec "$PY" -m ui "$@"
        ;;
    fleet)
        shift
        PY=$(command -v python3 || command -v python) || exit "$EXIT_USAGE"
        exec "$PY" "$LIB_DIR/fleet_cli.py" "$@"
        ;;
    media)
        shift
        PY=$(command -v python3 || command -v python) || exit "$EXIT_USAGE"
        exec "$PY" "$LIB_DIR/media.py" "$@"
        ;;
    desktop)
        shift
        PY=$(command -v python3 || command -v python) || exit "$EXIT_USAGE"
        exec "$PY" "$LIB_DIR/desktop.py" "$@"
        ;;
    prune)
        shift
        PY=$(command -v python3 || command -v python) || exit "$EXIT_USAGE"
        export PORCH_OUTPUT_DIR
        exec "$PY" "$LIB_DIR/retention.py" prune "$@"
        ;;
    quota|sessions|history)
        cmd=$1; shift
        # python3 on POSIX; Git Bash on Windows usually exposes only `python`
        PY=$(command -v python3 || command -v python) || {
            echo "Error: no python interpreter found (need python3 or python on PATH)" >&2
            exit $EXIT_USAGE
        }
        if [ "$cmd" = "quota" ]; then
            exec "$PY" "$LIB_DIR/quota.py" "$@"
        else
            exec "$PY" "$LIB_DIR/sessions.py" "$@"
        fi
        ;;
    *)
        echo "Error: unknown command: $1 (expected review|delegate|quota|sessions|desktop|ui|prune|media)" >&2
        usage >&2
        exit $EXIT_USAGE
        ;;
esac
