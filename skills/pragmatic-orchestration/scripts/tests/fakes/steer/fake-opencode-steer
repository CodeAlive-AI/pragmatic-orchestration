#!/usr/bin/env python3
"""OpenCode 2 HTTP/SSE test server with durable session messages."""
from __future__ import annotations
import base64
import json
import os
import sys
from pathlib import Path
import threading
import time
import uuid
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from socketserver import TCPServer
from urllib.parse import urlparse


class LoopbackHTTPServer(ThreadingHTTPServer):
    def server_bind(self):
        TCPServer.server_bind(self)
        self.server_name, self.server_port = self.server_address[:2]


class State:
    def __init__(self):
        self.session_id = "ses_" + uuid.uuid4().hex[:8]
        self.prompts = []
        self.messages = []
        self.queues = []
        self.active = False
        self.generation = 0
        self.lock = threading.RLock()
        self.slow = float(os.environ.get("PORCH_FAKE_STEER_SLOW", "0.35"))
        self.forms = {}
        self.connections = 0


STATE = State()


def broadcast(kind, data):
    frame = "data: " + json.dumps({"type": kind, "data": data}, ensure_ascii=False) + "\n\n"
    with STATE.lock:
        for q in STATE.queues:
            q.append(frame)


def drop_streams():
    """Close every open event stream, as a network drop would; later events go nowhere."""
    with STATE.lock:
        for q in STATE.queues:
            q.append(None)


def log_line(name, obj):
    path = os.environ.get(name)
    if path:
        with open(path, "a", encoding="utf-8") as f:
            f.write(json.dumps(obj) + "\n")


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):
        pass

    def auth(self):
        password = os.environ.get("OPENCODE_PASSWORD", "")
        expected = "Basic " + base64.b64encode(f"opencode:{password}".encode()).decode()
        if self.headers.get("Authorization") == expected:
            return True
        self.reply(401, {"error": "unauthorized"})
        return False

    def reply(self, status, obj):
        raw = json.dumps(obj).encode() if obj is not None else b""
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(raw)))
        self.end_headers()
        if raw:
            self.wfile.write(raw)

    def do_GET(self):
        if not self.auth():
            return
        path = urlparse(self.path).path
        if path == "/api/info":
            return self.reply(200, {"version": os.environ.get("PORCH_FAKE_OPENCODE_VERSION", "2.2.6")})
        if path == "/api/session/active":
            with STATE.lock:
                return self.reply(200, {"data": {STATE.session_id: {"type": "running"}} if STATE.active else {}})
        if path == "/api/experimental/job":
            return self.reply(200, {"data": []})
        if path == f"/api/session/{STATE.session_id}/inbox":
            return self.reply(200, {"data": []})
        if path == f"/api/session/{STATE.session_id}/message":
            with STATE.lock:
                return self.reply(200, {"data": list(STATE.messages), "cursor": {}})
        if path == f"/api/session/{STATE.session_id}/form":
            with STATE.lock:
                return self.reply(200, {"data": [f for f in STATE.forms.values() if f["state"] == "pending" and f.get("form")]})
        if path == f"/api/session/{STATE.session_id}/permission":
            return self.reply(200, {"data": []})
        if path.startswith(f"/api/session/{STATE.session_id}/message/"):
            wanted = path.rsplit("/", 1)[1]
            with STATE.lock:
                found = next((m for m in STATE.messages if m["id"] == wanted), None)
            return self.reply(200, {"data": found}) if found else self.reply(404, {"error": "not found"})
        if path == "/api/event":
            with STATE.lock:
                STATE.connections += 1
                number = STATE.connections
            always = bool(os.environ.get("PORCH_FAKE_OC_DROP_ALWAYS"))
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Connection", "close")
            self.end_headers()
            q = []
            with STATE.lock:
                STATE.queues.append(q)
            try:
                self.wfile.write(b'data: {"type":"server.connected","data":{}}\n\n')
                self.wfile.flush()
                if always:
                    time.sleep(.1)
                    return
                while True:
                    with STATE.lock:
                        items = list(q)
                        q.clear()
                    for item in items:
                        if item is None:
                            return
                        self.wfile.write(item.encode())
                        self.wfile.flush()
                    time.sleep(.03)
            except (BrokenPipeError, ConnectionResetError):
                pass
            finally:
                with STATE.lock:
                    STATE.queues.remove(q)
            return
        self.reply(404, {"error": "not found", "path": path})

    def do_POST(self):
        if not self.auth():
            return
        path = urlparse(self.path).path
        size = int(self.headers.get("Content-Length") or 0)
        body = json.loads(self.rfile.read(size)) if size else {}
        if path == "/api/session":
            return self.reply(200, {"data": {"id": STATE.session_id}})
        if path == f"/api/session/{STATE.session_id}/interrupt":
            with STATE.lock:
                was_active = STATE.active
                STATE.generation += 1
                STATE.active = False
            if was_active:
                broadcast("session.execution.interrupted", {"sessionID": STATE.session_id, "reason": "user"})
            return self.reply(200, {"interrupted": was_active})
        if path.startswith(f"/api/session/{STATE.session_id}/form/") and path.endswith("/reply"):
            form_id = path.split("/")[-2]
            with STATE.lock:
                entry = STATE.forms.get(form_id)
                if not entry or entry["state"] != "pending":
                    return self.reply(404, {"error": "no pending form"})
                entry["state"] = "answered"
                entry["answer"] = body.get("answer")
            log_line("PORCH_FAKE_OC_FORM_LOG", {"form": form_id, "answer": body.get("answer")})
            broadcast("form.replied", {"id": form_id, "sessionID": STATE.session_id, "answer": body.get("answer")})
            return self.reply(200, {"data": {}})
        if path == f"/api/session/{STATE.session_id}/prompt":
            mid = body["id"]
            log_line("PORCH_FAKE_OC_PROMPT_LOG", {"prompt": mid})
            client = body.get("metadata", {}).get("clientId", "")
            created = int(time.time() * 1000)
            with STATE.lock:
                STATE.prompts.append(body)
                STATE.messages.append({"id": mid, "type": "user", "text": body["text"]})
                STATE.active = True
                generation = STATE.generation
                count = len(STATE.prompts)
            self.reply(200, {"data": {"id": mid, "time": {"created": created}}})
            def work():
                broadcast("session.inbox.delivered", {"sessionID": STATE.session_id, "inboxID": mid})
                time.sleep(STATE.slow * .4)
                with STATE.lock:
                    if generation != STATE.generation:
                        return
                if os.environ.get("PORCH_FAKE_OC_PERMISSION"):
                    base = {"sessionID": STATE.session_id, "id": "call-permission", "assistantMessageID": "msg_tool"}
                    broadcast("session.tool.input.started", {**base, "name": "shell"})
                    broadcast("session.tool.called", {**base, "input": {"command": "mkdir /tmp/example"}, "executed": True})
                    time.sleep(float(os.environ.get("PORCH_FAKE_OC_PERMISSION_DELAY", "0")))
                    broadcast("permission.asked", {"sessionID": STATE.session_id, "id": "permission-example",
                        "action": "external_directory", "resources": ["/tmp/example/*"],
                        "metadata": {"command": "mkdir /tmp/example"}})
                    return
                if os.environ.get("PORCH_FAKE_OC_FORM"):
                    kind = os.environ["PORCH_FAKE_OC_FORM"]
                    config = {}
                    try:
                        config = json.loads(os.environ.get("OPENCODE_CONFIG_CONTENT") or "{}")
                    except json.JSONDecodeError:
                        pass
                    log_line("PORCH_FAKE_OC_FORM_LOG", {"config_websearch": config.get("websearch", "unset")})
                    # The real server never asks when config settled web search; PORCH_FAKE_OC_FORM_FORCE asks anyway.
                    settled = config.get("websearch") is False or isinstance(config.get("websearch"), dict)
                    if kind != "websearch" or not settled or os.environ.get("PORCH_FAKE_OC_FORM_FORCE"):
                        form_id = "frm_" + uuid.uuid4().hex[:12]
                        choice = {"key": "choice", "description": "Allow OpenCode to search the web for up-to-date information?",
                                  "type": "string", "required": True, "custom": False,
                                  "options": [{"value": "allow", "label": "Allow search via Exa"},
                                              {"value": "choose", "label": "Choose another provider"},
                                              {"value": "disable", "label": "Disable web search"}]}
                        forms = {
                            "websearch": {"title": "Web Search", "metadata": {"kind": "websearch.provider"}, "fields": [choice]},
                            # Same wording, different identifier: must not be treated as consent.
                            "lookalike": {"title": "Web Search", "metadata": {"kind": "other.kind"}, "fields": [choice]},
                            # Right identifier, unexpected shape: must not be treated as consent.
                            "odd-fields": {"title": "Web Search", "metadata": {"kind": "websearch.provider"},
                                           "fields": [{"key": "token", "type": "string", "required": True, "custom": True}]},
                            "other": {"title": "Pick a thing", "metadata": {"kind": "some.thing"},
                                      "fields": [{"key": "pick", "type": "string", "required": True, "custom": True}]},
                        }
                        form = {"id": form_id, "sessionID": STATE.session_id, **forms[kind]}
                        with STATE.lock:
                            STATE.forms[form_id] = {"state": "pending", "form": form}
                        broadcast("form.created", {"form": form})
                        deadline = time.time() + 6
                        while time.time() < deadline:
                            with STATE.lock:
                                if STATE.forms[form_id]["state"] != "pending" or generation != STATE.generation:
                                    break
                            time.sleep(.05)
                        else:
                            log_line("PORCH_FAKE_OC_FORM_LOG", {"form": form_id, "answer": "timeout"})
                            return
                if os.environ.get("PORCH_FAKE_OC_SCRIPT"):
                    run_script(mid)
                    return
                chunk = "FAKE_OC" + (f"+{client[:6]}" if client and client != "initial" else "")
                msg = "msg_answer_" + mid
                data = {"sessionID": STATE.session_id, "assistantMessageID": msg, "ordinal": 0}
                broadcast("session.text.delta", {**data, "delta": chunk})
                broadcast("session.text.ended", {**data, "text": chunk})
                with STATE.lock:
                    STATE.messages.append({"id": msg, "type": "assistant", "content": [{"type": "text", "text": chunk}]})
                time.sleep(STATE.slow * .3)
                with STATE.lock:
                    if generation != STATE.generation or count != len(STATE.prompts):
                        return
                    STATE.active = False
                    STATE.messages.append({"id": "idle_" + mid, "type": "idle", "outcome": "succeeded"})
                broadcast("session.execution.succeeded", {"sessionID": STATE.session_id})
            threading.Thread(target=work, daemon=True).start()
            return
        self.reply(404, {"error": "not found", "path": path})

    def do_DELETE(self):
        if self.auth():
            self.reply(204, None)


def run_script(mid):
    """Text, a tool call and more text, with an optional event-stream outage in the middle.

    PORCH_FAKE_OC_SCRIPT=drop        streams close after the tool starts; the tool result and the
                                     second text arrive while no stream is attached.
    PORCH_FAKE_OC_SCRIPT=drop-gone   same, then the server process dies.
    PORCH_FAKE_OC_SCRIPT=plain       no outage (reference run).
    PORCH_FAKE_OC_SCRIPT=hang        one text, then the session stays active forever.
    PORCH_FAKE_OC_DROP_ALWAYS=1      every event stream closes right after server.connected.
    """
    mode = os.environ["PORCH_FAKE_OC_SCRIPT"]
    msg = "msg_answer_" + mid
    sid = STATE.session_id
    content = []
    with STATE.lock:
        STATE.messages.append({"id": msg, "type": "assistant", "content": content})

    def text(ordinal, value):
        base = {"sessionID": sid, "assistantMessageID": msg, "ordinal": ordinal}
        broadcast("session.text.delta", {**base, "delta": value})
        broadcast("session.text.ended", {**base, "text": value})
        with STATE.lock:
            content.append({"type": "text", "text": value})
        time.sleep(.1)

    text(0, "Alpha ")
    if mode == "hang":
        time.sleep(30)  # session stays active, never completes
        return
    base = {"sessionID": sid, "id": "call-1", "assistantMessageID": msg}
    broadcast("session.tool.input.started", {**base, "name": "read"})
    broadcast("session.tool.called", {**base, "input": {"path": "a.txt"}, "executed": True})
    tool = {"type": "tool", "id": "call-1", "name": "read", "state": {"status": "running", "input": {"path": "a.txt"}}}
    with STATE.lock:
        content.append(tool)
    time.sleep(.2)
    if mode.startswith("drop"):
        drop_streams()
        time.sleep(.2)
        if mode == "drop-gone":
            os._exit(0)
    broadcast("session.tool.success", {**base, "output": "ok"})
    with STATE.lock:
        tool["state"] = {"status": "completed", "input": {"path": "a.txt"}, "content": []}
    text(1, "Beta ")
    if mode.startswith("drop"):
        time.sleep(float(os.environ.get("PORCH_FAKE_OC_GAP", "1.6")))
    text(2, "Gamma")
    with STATE.lock:
        STATE.active = False
        STATE.messages.append({"id": "idle_" + mid, "type": "idle", "outcome": "succeeded"})
    broadcast("session.execution.succeeded", {"sessionID": sid})


def main():
    if sys.argv[1:] == ["debug", "paths", "db"]:
        data = Path(os.environ.get("XDG_DATA_HOME") or (Path.home() / ".local/share")) / "opencode"
        filename = os.environ.get("OPENCODE_DB", os.environ.get("PORCH_FAKE_OPENCODE_CHANNEL_DB", "opencode.db"))
        print(filename if filename == ":memory:" else (data / filename).resolve())
        return 0
    pid_file = os.environ.get("PORCH_FAKE_OPENCODE_SERVER_PID_FILE")
    if pid_file:
        with open(pid_file, "w", encoding="utf-8") as f:
            f.write(str(os.getpid()))
    log = os.environ.get("PORCH_FAKE_ARGV_LOG")
    if log:
        with open(log, "a", encoding="utf-8") as f:
            f.write(json.dumps({"bin": "opencode-steer", "argv": sys.argv[1:]}) + "\n")
    args = sys.argv[1:]
    host = args[args.index("--hostname") + 1] if "--hostname" in args else "127.0.0.1"
    port = int(args[args.index("--port") + 1]) if "--port" in args else 0
    server = LoopbackHTTPServer((host, port), Handler)
    print(f"server listening on http://{host}:{server.server_address[1]}", flush=True)
    try:
        server.serve_forever()
    finally:
        server.server_close()
    return 0


if __name__ == "__main__":
    main()
