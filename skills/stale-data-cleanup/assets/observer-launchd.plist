<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <!-- Use a stable launcher path (for example the uv executable), not a patch-versioned Python path. -->
    <string>__INTERPRETER_COMMAND__</string>
    <!-- With uv, keep these as separate arguments; for direct Python, remove these three entries. -->
    <string>run</string>
    <string>--no-project</string>
    <string>python</string>
    <string>__RUNNER_PATH__</string>
    <string>--config</string>
    <string>__CONFIG_PATH__</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>__HOUR__</integer>
    <key>Minute</key>
    <integer>__MINUTE__</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <!-- Deliberately no ProcessType=Background, LowPriorityIO or Nice. The observer is a
       watchdog: one thread reading metadata once a day. In the background band macOS
       throttles its I/O so hard that a scan which takes 6-15 minutes at standard
       priority did not finish in 45 while the user was away (references/upkeep.md). -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__LOG_FOLDER__/observer.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_FOLDER__/observer.stderr.log</string>
</dict>
</plist>
